# Copy to web/.env.local and fill in. Never commit .env.local.

# Solana mainnet RPC used by the wallet (balances, token accounts).
# A Helius mainnet URL works: https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
# If unset, falls back to the public mainnet-beta RPC, which rate-limits quickly.
NEXT_PUBLIC_SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY

# Absolute path to the snapshot store directory. Point it at the repo's data/
# folder so the web app and the CLI poller share one history file.
# On Vercel, use /tmp/basis-data (the only writable path there).
BASIS_DATA_DIR=/absolute/path/to/Basis/data

# Optional. Uses Jupiter's paid Price API host instead of the free,
# rate-limited keyless tier.
# JUPITER_API_KEY=
